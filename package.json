{
  "name": "@patchbowl/mcp-server-template",
  "version": "0.1.0",
  "description": "A starter template for building an MCP server in TypeScript.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-server-template": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
